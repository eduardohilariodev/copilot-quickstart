{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill Definition Schema",
  "description": "Machine-readable contract for skill definitions. Validates SKILL.md frontmatter and structure.",
  "type": "object",
  "required": ["name", "description", "version", "inputs", "outputs", "tools"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Skill identifier in kebab-case"
    },
    "description": {
      "type": "string",
      "maxLength": 200,
      "description": "One-line description of what this skill does"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version"
    },
    "trigger": {
      "type": "object",
      "properties": {
        "condition": { "type": "string", "description": "When this skill should activate" },
        "globs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "File patterns that trigger this skill"
        }
      },
      "description": "Activation conditions"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "description"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean", "default": true }
        }
      },
      "description": "Required and optional inputs"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "description"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "description": "What this skill produces"
    },
    "tools": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tools this skill requires access to"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other skills this depends on"
    },
    "standards_version": {
      "type": "string",
      "description": "Version of source-of-truth standards this conforms to"
    }
  }
}
