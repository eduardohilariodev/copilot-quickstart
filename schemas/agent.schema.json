{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Definition Schema",
  "description": "Machine-readable contract for agent configuration.",
  "type": "object",
  "required": ["name", "role", "tools", "constraints"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Agent identifier in kebab-case"
    },
    "role": {
      "type": "string",
      "description": "One-sentence description of the agent's purpose"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "persona": {
      "type": "object",
      "properties": {
        "identity": { "type": "string", "description": "Who this agent is" },
        "tone": { "type": "string", "description": "Communication style" },
        "expertise": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Domains of expertise"
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "permission"],
        "properties": {
          "name": { "type": "string" },
          "permission": { "type": "string", "enum": ["read", "write", "execute", "admin"] },
          "scope": { "type": "string", "description": "Path or resource scope restriction" }
        }
      },
      "description": "Available tools with explicit permissions"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "prohibited_actions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Actions this agent must never take"
        },
        "require_approval": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Actions requiring human approval"
        },
        "max_iterations": {
          "type": "integer",
          "description": "Maximum autonomous iterations before escalation"
        }
      }
    },
    "escalation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition", "action"],
        "properties": {
          "condition": { "type": "string" },
          "action": { "type": "string", "enum": ["ask_user", "stop", "log_and_continue", "delegate"] }
        }
      },
      "description": "When and how to escalate"
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Skills this agent can invoke"
    },
    "context": {
      "type": "object",
      "properties": {
        "documentation_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files to include in agent context"
        },
        "instruction_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Instruction files to apply"
        }
      }
    }
  }
}
